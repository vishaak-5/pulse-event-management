# Copy to server/.env for local development (that file is git-ignored).
# Leave MONGODB_URI empty to run a local MongoDB automatically (data in server/.data).
MONGODB_URI=
# Any random string of 32+ characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
PORT=8080
SEED_ENABLED=true
SEED_PASSWORD=Demo@1234
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
